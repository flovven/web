{
  "name": "@flovven/web",
  "version": "0.1.0",
  "private": true,
  "description": "flovven 统一 Web 框架垫片层：TypeScript 实现，适配 hono / fastify / elysia / koa2",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b --pretty false",
    "clean": "node -e \"require('fs').rmSync('packages/core/dist',{recursive:true,force:true}); ['adapter-hono','adapter-fastify','adapter-elysia','adapter-koa'].forEach(n=>require('fs').rmSync('packages/'+n+'/dist',{recursive:true,force:true}))\"",
    "test": "npm --prefix core test && npm --prefix client test && npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "koa": "^2.16.4"
  }
}
