{
  "name": "@gyre/web-adapter-elysia",
  "version": "0.1.0",
  "private": true,
  "description": "gyre 统一 Web 垫片层 elysia 适配包",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
