{
  "name": "@flovven/web-adapter-koa",
  "version": "0.1.0",
  "description": "flovven 统一 Web 垫片层 koa2 适配包",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@flovven/web-core": "file:../../core"
  },
  "peerDependencies": {
    "@koa/router": "^12",
    "koa": "^2"
  },
  "peerDependenciesMeta": {
    "koa": {
      "optional": true
    },
    "@koa/router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/koa": "^2.15.2",
    "@types/koa__router": "^12.0.5",
    "@types/node": "^20.12.7",
    "typescript": "^5.4.5",
    "koa": "^2.14.0",
    "@koa/router": "^12.0.0"
  }
}
